# =====================================================================
# WanderSync — Backend environment variables
# Copy to backend/.env and fill in real values. NEVER commit backend/.env
# =====================================================================

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- MongoDB (primary database) ---
# Local:  mongodb://localhost:27017/wandersync
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/wandersync?retryWrites=true
MONGODB_URI=mongodb://localhost:27017/wandersync
MONGODB_DB=wandersync

# --- JWT authentication ---
JWT_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- CORS / client ---
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (server-side only; never exposed to the frontend) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- External travel data providers (server-side only) ---
MAPS_API_KEY=
WEATHER_API_KEY=

# --- Rate limiting ---
THROTTLE_AI_RATE=10/min
THROTTLE_AUTH_RATE=20/min
